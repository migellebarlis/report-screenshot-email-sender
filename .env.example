# Copy this file to .env and fill in the values. .env is not committed.

# --- Google Drive ---
# Shared Drive ID: the last part of drive.google.com/drive/folders/<ID>
SHARED_DRIVE_ID=
# Path to the .xlsx inside the Shared Drive, folders separated by /
FILE_PATH=Reports/daily.xlsx

# --- Email ---
# Separate multiple addresses with commas
MESSAGE_TO=
MESSAGE_CC=
# Should be the Google account you sign in with
MESSAGE_FROM=

# Subject becomes "<EMAIL_SUBJECT> - October 10, 2026"
EMAIL_SUBJECT=Daily Report
# Used in "Please find below today's <REPORT_NAME> as of ..."
REPORT_NAME=daily report
# Optional link added to the email body; leave blank to omit
REPORT_LINK=
# Name in the email sign-off
SENDER_NAME=

# --- Optional ---
# Local file name for the screenshot
TEMP_IMAGE_FILE_NAME=image.png
